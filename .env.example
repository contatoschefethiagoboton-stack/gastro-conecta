# Configuração do Eventos Conecta. Nunca coloque valores reais no repositório:
# no Render, cadastre estas variáveis em Environment.

# Obrigatória: banco MySQL externo (TiDB Cloud, Aiven, etc.)
# Ex.: mysql://usuario:senha@gateway01.us-east-1.prod.aws.tidbcloud.com:4000/test
DATABASE_URL=

# Recomendado: endereço público do site (canonical, compartilhamentos, Google)
GASTRO_PUBLIC_ORIGIN=

# Opcional: SSL do banco (automático para provedores na nuvem). off | require | verify
DATABASE_SSL=
# Opcional: certificado CA em texto, se o provedor exigir
DATABASE_SSL_CA=

# Opcional: cria/atualiza o administrador sem usar o código dos logs
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Opcional: liga o Copilot (chat com IA)
OPENAI_API_KEY=
COPILOT_MODEL=

# Porta (o Render define sozinho)
PORT=3000

# Assinatura mensal do profissional, em centavos (sem comissão sobre eventos)
GC_SUBSCRIPTION_PRICE_CENTS=4990

# Mercado Pago: cobrança da assinatura via Pix (avulso e Pix automático/recorrente).
# Webhook a cadastrar no Mercado Pago: https://SEU-SITE/api/gastro/webhooks/mercadopago
# (eventos: Pagamentos, Planos e assinaturas). GASTRO_PUBLIC_ORIGIN precisa estar definido.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# E-mail para "Esqueci minha senha" (Resend). Sem isso, a administração gera o link no painel.
RESEND_API_KEY=
MAIL_FROM=

# IA grátis (opcional): Groq no lugar da OpenAI — OPENAI_API_KEY=gsk_..., e:
# OPENAI_API_BASE=https://api.groq.com/openai/v1
# COPILOT_MODEL=llama-3.3-70b-versatile

# Indexação rápida (docs/AUTOMACAO.md). IndexNow: 8 a 128 letras/números que você inventa.
INDEXNOW_KEY=
# JSON da conta de serviço do Google Cloud (inteiro ou em base64) com acesso de Proprietário no Search Console.
GOOGLE_INDEXING_CREDENTIALS=
# GOOGLE_INDEXING_DAILY_QUOTA=200

# Robô do Instagram/Facebook/WhatsApp (webhook da Meta) e posts automáticos.
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
META_IG_USER_ID=
# META_GRAPH_VERSION=v21.0

# Matching de pedidos: quantos profissionais avisar e quantos recebem WhatsApp.
# MATCH_NOTIFY_LIMIT=30
# MATCH_WHATSAPP_LIMIT=10
