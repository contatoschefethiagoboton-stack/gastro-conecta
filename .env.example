# Configuração do GastroConecta. Nunca coloque valores reais no repositório:
# no Render, cadastre estas variáveis em Environment.

# Obrigatória: banco MySQL externo (TiDB Cloud, Aiven, etc.)
# Ex.: mysql://usuario:senha@gateway01.us-east-1.prod.aws.tidbcloud.com:4000/test
DATABASE_URL=

# Recomendado: endereço público do site (canonical, compartilhamentos, Google)
GASTRO_PUBLIC_ORIGIN=

# Opcional: SSL do banco (automático para provedores na nuvem). off | require | verify
DATABASE_SSL=
# Opcional: certificado CA em texto, se o provedor exigir
DATABASE_SSL_CA=

# Opcional: cria/atualiza o administrador sem usar o código dos logs
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Opcional: liga o Copilot (chat com IA)
OPENAI_API_KEY=
COPILOT_MODEL=

# Porta (o Render define sozinho)
PORT=3000

# Regras de diária mínima (centavos) e comissão de eventos (8 a 12)
GC_EVENT_COMMISSION_PCT=10
GC_MIN_DAILY_COZINHEIRO_CENTS=15000
GC_MIN_DAILY_AJUDANTE_CENTS=12000
GC_MIN_DAILY_GARCOM_CENTS=12000
GC_MIN_DAILY_BARMAN_CENTS=15000
